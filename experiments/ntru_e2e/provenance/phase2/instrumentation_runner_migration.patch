+def stamp_trial_source(trial, summary, version=None):
+    """Keep the source used by each attempted trial, including older attempts."""
+    version = trial.get("instrumentation_version", version or summary.get("active_instrumentation_version", "v1"))
+    expected = (summary["source_sha256"] if version == "v1" else
+                summary.get("active_source_sha256", summary["source_sha256"]))
+    if version not in {"v1", summary.get("active_instrumentation_version", "v1")}:
+        raise ValueError(f"Unknown instrumentation version on trial: {version}")
+    if trial.get("source_sha256", expected) != expected:
+        raise ValueError("Stored trial source hashes do not match its instrumentation version")
+    trial.update(instrumentation_version=version, source_sha256=dict(expected))
+
